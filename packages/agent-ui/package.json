{
  "name": "@metabindai/agent-ui",
  "version": "0.1.1",
  "description": "Prebuilt, drop-in React chat UI for the Metabind agent proxy: the assistant-ui runtime, MetabindAgentTransport, and MCP UI tool rendering. Configure with your Metabind project + key and render <AgentChat />. Works standalone or embedded via the iframe bridge at @metabindai/agent-ui/protocol.",
  "type": "module",
  "main": "./index.ts",
  "module": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./protocol": "./src/protocol.ts",
    "./styles.css": "./styles.css",
    "./agent-ui.css": "./dist/agent-ui.css"
  },
  "files": [
    "dist",
    "src",
    "public",
    "index.ts",
    "styles.css"
  ],
  "scripts": {
    "build": "rm -rf dist && pnpm run build:css",
    "build:css": "tailwindcss -i ./css/build.css -o ./dist/agent-ui.css --minify",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "metabind",
    "agent",
    "chat",
    "assistant-ui",
    "mcp",
    "mcp-ui"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/mcp": "^1.0.40",
    "@assistant-ui/react": "^0.12.28",
    "@assistant-ui/react-ai-sdk": "1.3.21",
    "@assistant-ui/react-markdown": "^0.12.11",
    "@assistant-ui/store": "0.2.11",
    "@assistant-ui/tap": "0.5.11",
    "@base-ui/react": "^1.4.1",
    "@mcp-ui/client": "^7.1.0",
    "@metabindai/agent-core": "workspace:^",
    "@metabindai/agent-ai-sdk": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.13"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.11",
    "typescript": "~5.6.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/metabindai/metabind-web",
    "directory": "packages/agent-ui"
  }
}
